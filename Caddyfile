# magic-lord.baconana.com — SvelteKit (adapter-node) behind Caddy.
# Place this host block in /etc/caddy/Caddyfile (or import this file),
# then: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# The Node server must be running on 127.0.0.1:3000 (PM2: `pm2 start ecosystem.config.cjs`).

magic-lord.baconana.com {
	encode zstd gzip

	# SvelteKit assets have content hashes in their names, so they never change.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path /favicon.* /robots.txt
	header @static Cache-Control "public, max-age=3600"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Uncomment if you want request logs on disk (the directory must be writable
	# by the caddy user):
	# log {
	# 	output file /var/log/caddy/magic-lord.log
	# 	format console
	# }
}
